# Copie este arquivo para .streamlit/secrets.toml (que NÃO vai para o GitHub)
# e troque a senha. No Streamlit Cloud, cole estas linhas em Settings > Secrets.

# Administrador inicial: criado só quando o banco ainda não tem nenhum usuário. A senha precisa ter pelo menos
# 10 caracteres e o app pede a troca no primeiro acesso. Depois disso o administrador cria os demais usuários
# na tela "Usuários" e estas duas linhas não são mais usadas (pode removê-las).
admin_login = "admin"
admin_senha = "troque-por-uma-senha-forte"

# Só para o deploy de demonstração: recarrega os dados FICTÍCIOS quando o banco estiver vazio e cria contas
# fictícias dos três perfis (demo.admin, demo.coord, prof.ana, prof.bruno; senha pública). Nunca use com dados reais.
demo_automatica = true

# Opcional: minutos sem uso até a sessão ser encerrada (padrão 15, mínimo 1,5). Normalmente não precisa mudar.
# inatividade_minutos = 15
